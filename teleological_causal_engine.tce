        description: "Initiates a series of causally linked interventions to optimize global carbon sinks and sources."
        trigger: "CWS_Model_Prediction_of_Planetary_Carbon_Imbalance_Exceeds_Threshold_v3"
        causal_steps:
          - step_id: "Step_1_Atmospheric_Capture_Optimization"
            target_system: "Atmospheric_Dynamics"
