    },
    {
      "axiom_id": "UCA-003-ActionReaction",
      "statement": "For every action, there is an equal and opposite reaction; every force creates a response.",
      "domains": ["Physics", "SocialDynamics", "Ecology", "SystemsTheory"],
      "implications": [
        "Interconnectedness_of_All_Phenomena",
