    },
    {
      "axiom_id": "UCA-002-EntropyIncrease",
      "statement": "In any isolated system, the total entropy (disorder) can only increase over time, or remain constant in ideal reversible processes.",
      "domains": ["Physics", "Thermodynamics", "InformationTheory", "ComplexSystems"],
      "implications": [
        "Irreversibility_of_Time_Flow",
