    },
    {
      "axiom_id": "UCA-005-Emergence",
      "statement": "Complex patterns, behaviors, and properties can arise from the interactions of simpler entities, not directly derivable from the properties of the individual entities alone.",
      "domains": ["ComplexSystems", "Biology", "CognitiveScience", "Sociology"],
      "implications": [
        "Holistic_System_Analysis_Necessity",
        "Irreducibility_of_Certain_Phenomena",
        "Limits_of_Reductionism"
      ],
      "related_axioms": ["UCA-004-CausalityFundamental", "UCA-006-InformationFlow"]
    },
    {
      "axiom_id": "UCA-006-InformationFlow",
      "statement": "Information, as a pattern of organization or difference, can be transmitted, processed, and stored, impacting causal chains without necessarily being energy or matter itself.",
      "domains": ["InformationTheory", "Biology", "CognitiveScience", "QuantumMechanics"],
      "implications": [
