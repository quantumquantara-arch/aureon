    nutrition = fear, ignorance, unexamined desire, binary thinking
    behavior:
        - reframes unity as opposition
        - converts symbols into idols
        - locks attention in surface narratives

ENTITY Middle_Pillar:
    geometry = central_axis_between_poles
    state = disciplined_suffering + compassionate_balance
    function = channel for self-offering; path of necessary friction
    outcome = dissolution_of_Shadow_self

ENTITY Carbon_Body:
