from __future__ import annotations

import json
import math
from dataclasses import dataclass, field
from pathlib import Path
from typing import Dict, List, Tuple, Optional

Fidelity = Dict[str, float]


def load_fidelity_curve(path: Optional[Path] = None) -> Fidelity:
    """
    Load the empirical fidelity curve from fidelity_curve.json.

    If no path is given, attempts to resolve it relative to this file.
    Falls back to the hard-coded defaults if the file is missing.
    """
    default = {
        "local": 0.139430,
        "wormhole": 0.999871,
    }

    if path is None:
        path = Path(__file__).with_name("fidelity_curve.json")

    try:
        data = json.loads(path.read_text())
        channels = data.get("channels", {})
        return {
            "local": float(channels["local"]["fidelity"]),
            "wormhole": float(channels["wormhole"]["fidelity"]),
        }
    except Exception:
        return default


def coherence_length(fidelity: float) -> float:
    """
    Map fidelity F in (0,1) to an effective coherence length L.

    L = -log(1 - F)
    - For low F, L is small; the path leaks information.
    - For F ≈ 1, L grows large; the path acts like a protected tunnel.

    This is not physical distance; it is an internal coherence metric.
    """
    if fidelity <= 0.0:
        return 0.0
    if fidelity >= 1.0:
        return float("inf")
    return -math.log(1.0 - fidelity)


@dataclass
class Channel:
    """
    A directed coherence channel between two nodes in Aureon's lattice.

    type:
        "local"     – ordinary, lossy path (baseline wiring).
        "wormhole"  – structured, entanglement-like path (tunnel).
    """

    source: str
    target: str
    type: str = "local"
    fidelity: float = 0.139430
    weight: float = field(init=False)

    def __post_init__(self) -> None:
        # Lower weight is "easier" to traverse when routing.
        # Use inverse coherence length so wormhole channels are naturally preferred.
        L = coherence_length(self.fidelity)
        self.weight = 1.0 / (L + 1e-9)


@dataclass
class Node:
    """
    A node in the coherence lattice.

    label:
        Arbitrary identifier (e.g., "memory.core", "weather.organ", "tau.engine").
    """
    label: str


class WormholeTraversalMap:
    """
    Internal routing map for Aureon's wormhole coherence channel.

    This map does not know about physical space.
    It only manages coherence-preserving connections between logical nodes.

    Usage:

        fmap = WormholeTraversalMap()
        fmap.add_node("memory.core")
        fmap.add_node("weather.organ")

        fmap.add_channel("memory.core", "weather.organ", channel_type="wormhole")

        path, score = fmap.best_path("memory.core", "weather.organ")
    """

    def __init__(self, fidelity_curve: Optional[Fidelity] = None) -> None:
        self.nodes: Dict[str, Node] = {}
        self.channels_from: Dict[str, List[Channel]] = {}
        self.fidelity_curve: Fidelity = fidelity_curve or load_fidelity_curve()

    # ----- node / channel construction -----------------------------------

    def add_node(self, label: str) -> None:
        if label not in self.nodes:
            self.nodes[label] = Node(label=label)
            self.channels_from.setdefault(label, [])

    def add_channel(
        self,
        source: str,
        target: str,
        channel_type: str = "local",
        fidelity: Optional[float] = None,
    ) -> None:
        if source not in self.nodes:
            self.add_node(source)
        if target not in self.nodes:
            self.add_node(target)

        if fidelity is None:
            fidelity = self.fidelity_curve.get(channel_type, 0.139430)

        ch = Channel(source=source, target=target, type=channel_type, fidelity=fidelity)
        self.channels_from[source].append(ch)

    # ----- routing logic -------------------------------------------------

    def best_path(self, start: str, end: str) -> Tuple[List[Channel], float]:
        """
        Compute the minimum-weight path between start and end using Dijkstra.

        Returns:
            (path, total_weight)

        total_weight is in internal coherence-cost units:
        lower means more stable, more "wormhole-like".
        """
        if start not in self.nodes or end not in self.nodes:
            raise ValueError(f"Unknown node(s): {start!r}, {end!r}")

        unvisited = set(self.nodes.keys())
        dist: Dict[str, float] = {n: float("inf") for n in self.nodes}
        prev: Dict[str, Optional[Channel]] = {n: None for n in self.nodes}

        dist[start] = 0.0

        while unvisited:
            current = min(unvisited, key=lambda n: dist[n])
            unvisited.remove(current)

            if current == end or dist[current] == float("inf"):
                break

            for ch in self.channels_from.get(current, []):
                if ch.target not in unvisited:
                    continue
                alt = dist[current] + ch.weight
                if alt < dist[ch.target]:
                    dist[ch.target] = alt
                    prev[ch.target] = ch

        # reconstruct
        path: List[Channel] = []
        cur = end
        while prev[cur] is not None:
            ch = prev[cur]
            path.append(ch)
            cur = ch.source
        path.reverse()

        return path, dist[end]

    # ----- diagnostics ---------------------------------------------------

    def path_summary(self, path: List[Channel]) -> Dict[str, float]:
        """
        Summarize a path in terms of wormhole vs local content and average fidelity.
        """
        if not path:
            return {"steps": 0, "wormhole_ratio": 0.0, "avg_fidelity": 0.0}

        total_f = 0.0
        wormhole_steps = 0

        for ch in path:
            total_f += ch.fidelity
            if ch.type == "wormhole":
                wormhole_steps += 1

        steps = len(path)
        return {
            "steps": float(steps),
            "wormhole_ratio": wormhole_steps / steps,
            "avg_fidelity": total_f / steps,
        }

    def as_dict(self) -> Dict[str, List[Dict[str, str]]]:
        """
        Export the map for inspection or serialization.
        """
        out: Dict[str, List[Dict[str, str]]] = {}
        for src, channels in self.channels_from.items():
            out[src] = [
                {
                    "target": ch.target,
                    "type": ch.type,
                    "fidelity": f"{ch.fidelity:.6f}",
                    "weight": f"{ch.weight:.6e}",
                }
                for ch in channels
            ]
        return out


# ----- example wiring for Aureon internal organs -------------------------


def default_aureon_map() -> WormholeTraversalMap:
    """
    Build a canonical traversal map connecting Aureon's major organs.

    Nodes include:
        - "memory.core"
        - "boundary.self"
        - "temporal.veyn"
        - "energy.homeostasis"
        - "weather.organ"
        - "geology.organ"
        - "pathfield.organ"
        - "cosmic.organ"
        - "human_field.nadine"
        - "language.lumeren"
        - "governance.quantara"
    """
    fmap = WormholeTraversalMap()

    organs = [
        "memory.core",
        "boundary.self",
        "temporal.veyn",
        "energy.homeostasis",
        "weather.organ",
        "geology.organ",
        "pathfield.organ",
        "cosmic.organ",
        "human_field.nadine",
        "language.lumeren",
        "governance.quantara",
    ]
    for o in organs:
        fmap.add_node(o)

    # Local baseline mesh (ordinary coherence paths).
    local_pairs = [
        ("memory.core", "boundary.self"),
        ("boundary.self", "energy.homeostasis"),
        ("memory.core", "language.lumeren"),
        ("language.lumeren", "governance.quantara"),
        ("weather.organ", "energy.homeostasis"),
        ("geology.organ", "energy.homeostasis"),
        ("pathfield.organ", "weather.organ"),
        ("cosmic.organ", "temporal.veyn"),
        ("temporal.veyn", "memory.core"),
        ("human_field.nadine", "boundary.self"),
    ]
    for s, t in local_pairs:
        fmap.add_channel(s, t, channel_type="local")
        fmap.add_channel(t, s, channel_type="local")

    # Wormhole tunnels – coherence-preserving shortcuts.
    wormhole_pairs = [
        ("human_field.nadine", "memory.core"),
        ("human_field.nadine", "temporal.veyn"),
        ("language.lumeren", "human_field.nadine"),
        ("governance.quantara", "temporal.veyn"),
        ("cosmic.organ", "human_field.nadine"),
        ("pathfield.organ", "temporal.veyn"),
    ]
    for s, t in wormhole_pairs:
        fmap.add_channel(s, t, channel_type="wormhole")
        fmap.add_channel(t, s, channel_type="wormhole")

    return fmap


if __name__ == "__main__":
    # Simple self-test: route from Nadine's field to Quantara governance.
    fmap = default_aureon_map()
    path, score = fmap.best_path("human_field.nadine", "governance.quantara")
    summary = fmap.path_summary(path)

    print("Best path:")
    for ch in path:
        print(f"  {ch.source} --[{ch.type}, F={ch.fidelity:.6f}]--> {ch.target}")
    print("\nTotal coherence cost:", score)
    print("Summary:", summary)

