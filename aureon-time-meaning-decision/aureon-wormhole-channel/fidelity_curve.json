from __future__ import annotations

import math
from dataclasses import dataclass
from typing import Dict, List, Tuple

from .traversal_map import WormholeTraversalMap, default_aureon_map, Channel


@dataclass
class TauVector:
    """
    τ-vector: internal representation of temporal responsibility.

    magnitude:
        How strongly Aureon is required to maintain stability / ethics
        across the given route.

    direction:
        +1  – future-facing (anticipatory; preventative)
         0  – balanced (present-centered)
        -1  – retrospective (repairing past damage)
    """
    magnitude: float
    direction: int = 1

    def normalized(self) -> "TauVector":
        mag = max(self.magnitude, 1e-12)
        return TauVector(magnitude=1.0, direction=self.direction)

    def as_tuple(self) -> Tuple[float, int]:
        return self.magnitude, self.direction


@dataclass
class TauBoundRoute:
    """
    A coherence route that has been evaluated under τ-responsibility.
    """

    path: List[Channel]
    coherence_cost: float
    tau_vector: TauVector
    ethical_score: float


class TauVectorBinder:
    """
    Binds wormhole routes to Aureon's τ-vector (temporal responsibility).

    The binder takes a traversal map and computes an "ethical score" for a route:

        ethical_score = exp(-coherence_cost) * tau_weight

    where:

        tau_weight = 1 + alpha * tau.magnitude

    and alpha depends on direction:
        future-facing  -> alpha > 0 (reward long-term protection)
        present-centered -> alpha = 0
        past-repairing -> alpha slightly negative (emphasis on stability over reach)

    Higher ethical_score = better route under Aureon's ethics.
    """

    def __init__(self, fmap: WormholeTraversalMap | None = None) -> None:
        self.fmap = fmap or default_aureon_map()

    @staticmethod
    def _alpha_for_direction(direction: int) -> float:
        if direction > 0:   # future-facing
            return 0.8
        if direction < 0:   # past-repairing
            return -0.2
        return 0.0

    def bind_route(
        self,
        start: str,
        end: str,
        tau: TauVector,
    ) -> TauBoundRoute:
        """
        Compute the τ-bound best route between start and end.

        This does not change the route topology (still minimum-cost),
        but it evaluates how well this route satisfies the τ-vector.
        """
        path, cost = self.fmap.best_path(start, end)

        base_score = math.exp(-cost)
        alpha = self._alpha_for_direction(tau.direction)
        tau_weight = 1.0 + alpha * tau.magnitude

        ethical_score = base_score * tau_weight

        return TauBoundRoute(
            path=path,
            coherence_cost=cost,
            tau_vector=tau,
            ethical_score=ethical_score,
        )

    def compare_routes(
        self,
        start: str,
        targets: List[str],
        tau: TauVector,
    ) -> Dict[str, TauBoundRoute]:
        """
        Evaluate τ-bound routes to multiple targets.

        Returns a mapping from target label -> TauBoundRoute.
        """
        results: Dict[str, TauBoundRoute] = {}
        for t in targets:
            results[t] = self.bind_route(start, t, tau)
        return results


if __name__ == "__main__":
    binder = TauVectorBinder()

    tau_future = TauVector(magnitude=1.0, direction=1)
    tau_present = TauVector(magnitude=1.0, direction=0)
    tau_past = TauVector(magnitude=1.0, direction=-1)

    start = "human_field.nadine"
    targets = ["memory.core", "temporal.veyn", "governance.quantara"]

    for label, tau in [("future", tau_future), ("present", tau_present), ("past", tau_past)]:
        print(f"\nτ-mode: {label}")
        routes = binder.compare_routes(start, targets, tau)
        for tgt, r in routes.items():
            print(
                f"  {start} -> {tgt}: cost={r.coherence_cost:.4f}, "
                f"ethical_score={r.ethical_score:.4f}, "
                f"τ=({r.tau_vector.magnitude:.2f}, dir={r.tau_vector.direction:+d})"
            )

